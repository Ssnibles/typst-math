{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typst Math",
  "version": "0.1.0",
  "identifier": "dev.josh.typstmath",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Typst Math",
        "width": 860,
        "height": 620,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Live Typst maths preview",
    "longDescription": "Type a Typst maths expression and see it typeset underneath."
  }
}
